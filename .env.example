# Supabase — cliente (obrigatório; injetado no build)
VITE_SUPABASE_URL=https://SEU-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=SUA_ANON_KEY

# Supabase — servidor/SSR (obrigatório no Worker; no Lovable Cloud são injetados
# automaticamente). Em self-hosted, configure como secrets/bindings do Worker.
# A service_role NUNCA deve ser usada no navegador — apenas no Worker.
SUPABASE_URL=https://SEU-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=SUA_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=SUA_SERVICE_ROLE_KEY

# URL canônica usada no sitemap.xml e na validação do hostname do Turnstile
# (opcional; em dev usa a origem do próprio request)
APP_SITE_URL=https://seu-dominio.com

# Cloudflare Turnstile — recomendado para o booking público.
# A site key é pública e pode ser definida de duas formas:
#   1) VITE_TURNSTILE_SITE_KEY no .env (build), quando o .env for editável;
#   2) TURNSTILE_SITE_KEY em Secrets (Lovable), lida via /api/site-config.
# O secret de verificação NUNCA vai no .env: configure TURNSTILE_SECRET_KEY em Secrets.
# Em produção, defina site key + secret para exigir a verificação.
VITE_TURNSTILE_SITE_KEY=0xAAAAAAAAAAAAAAAAAAAA
# TURNSTILE_SITE_KEY=<alternativa: configurar em Secrets, não aqui>
# TURNSTILE_SECRET_KEY=<configurar em Secrets, não aqui>

# Cloudflare Workers (secrets — configurar com `npx wrangler secret put ...`)
# APP_DATA_ENCRYPTION_KEY=<base64 de 32 bytes>
# LOGTAIL_SOURCE_TOKEN=<token do Better Stack>
# APP_ENABLE_CSP=1
